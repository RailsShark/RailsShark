---
import { url } from '../lib/url';
import { stats } from '../config/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__body">
    <h1 id="hero-title">Software that holds up at depth.</h1>
    <p class="hero__lede">
      RailsShark is a software engineering studio. We design, build and run mobile apps, backends, cloud
      infrastructure and connected devices for teams and institutions around the world.
    </p>
    <div class="hero__actions">
      <a class="btn" href={url('/contact/')}>Start a project</a>
      <a class="btn btn--ghost" href={url('/work/')}>See our work</a>
    </div>
  </div>

  <ul class="wrap soundings" aria-label="RailsShark in numbers">
    {stats.map((s) => (
      <li>
        <span class="soundings__value">{s.value}</span>
        <span class="soundings__label">{s.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding-block: calc(var(--s8) * 1.1) var(--s7);
  }

  .hero h1 {
    max-width: 11ch;
  }

  .hero__lede {
    margin-top: var(--s5);
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s6);
  }

  /* The studio's numbers, in one row under the call to action. */
  .soundings {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s5);
    margin-top: var(--s8);
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }

  .soundings li {
    position: relative;
    display: grid;
    padding-left: 1.1rem;
  }

  .soundings li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
  }

  .soundings__value {
    font-family: var(--font-figures);
    font-stretch: var(--figures-stretch);
    font-weight: var(--figures-weight);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .soundings__label {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .soundings {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--s5);
      margin-top: var(--s7);
    }
  }
</style>
