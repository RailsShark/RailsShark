---
import { url } from '../lib/url';
import { stats } from '../config/site';

/** Where each sounding sits on the chart, in % of the hero box (desktop only). */
const spots = [
  { x: 62, y: 24 },
  { x: 80, y: 40 },
  { x: 67, y: 63 },
  { x: 84, y: 76 },
];
---
<section class="hero" aria-labelledby="hero-title">
  <canvas class="hero__chart" aria-hidden="true"></canvas>

  <div class="wrap hero__body">
    <h1 id="hero-title">Software that holds up at depth.</h1>
    <p class="hero__lede">
      RailsShark is a software engineering studio. We design, build and run mobile apps, backends, cloud
      infrastructure and connected devices for teams around the world.
    </p>
    <div class="hero__actions">
      <a class="btn" href={url('/contact/')}>Start a project</a>
      <a class="btn btn--ghost" href={url('/work/')}>See our work</a>
    </div>
  </div>

  <ul class="soundings" aria-label="RailsShark in numbers">
    {stats.map((s, i) => (
      <li style={`--x:${spots[i].x}%;--y:${spots[i].y}%`}>
        <span class="soundings__value">{s.value}</span>
        <span class="soundings__label">{s.label}</span>
      </li>
    ))}
  </ul>
  <p class="hero__hint" aria-hidden="true">Click the water to ping</p>
</section>

<script>
  import { mountContours } from '../scripts/contour';
  const c = document.querySelector<HTMLCanvasElement>('.hero__chart');
  if (c) mountContours(c);
</script>

<style>
  .hero {
    position: relative;
    min-height: min(88svh, 860px);
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(120% 90% at 85% 55%, color-mix(in srgb, var(--surface2) 70%, transparent), transparent 70%),
      var(--bg);
  }

  .hero__chart {
    position: absolute;
    inset: 0;
    z-index: -1;
    cursor: crosshair;
  }

  .hero__body {
    padding-block: var(--s8);
    pointer-events: none;
  }

  .hero__body > * {
    pointer-events: auto;
  }

  .hero h1 {
    max-width: 11ch;
    text-shadow: 0 0 1.2em var(--bg);
  }

  .hero__lede {
    margin-top: var(--s5);
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    text-shadow: 0 0 1em var(--bg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s6);
  }

  .hero__actions .btn--ghost {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  /* Soundings: the studio's numbers, set like depth marks on a chart. */
  .soundings {
    list-style: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .soundings li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    padding-left: 1.1rem;
    pointer-events: none;
  }

  .soundings li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    background: var(--bg);
  }

  .soundings__value {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 700;
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .soundings__label {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .hero__hint {
    position: absolute;
    right: var(--gutter);
    bottom: var(--s4);
    font-size: var(--step--1);
    color: var(--muted);
    opacity: 0.7;
  }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .hero__hint {
      display: none;
    }
  }

  :global(:root[data-motion='off']) .hero__hint,
  :global(:root[data-contours='off']) .hero__hint {
    display: none;
  }

  @media (max-width: 1000px) {
    .hero {
      align-items: end;
    }

    .hero__body {
      padding-block: var(--s8) var(--s5);
    }

    .soundings {
      position: relative;
      inset: auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s5);
      width: min(100% - 2 * var(--gutter), var(--wrap));
      margin: 0 auto var(--s7);
    }

    .soundings li {
      position: relative;
      left: auto;
      top: auto;
    }
  }

  @media (min-width: 1001px) and (max-width: 1240px) {
    .soundings li {
      left: calc(var(--x) + 2%);
    }
  }
</style>
