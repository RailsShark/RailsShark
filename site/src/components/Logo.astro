---
/** RailsShark mark: the fin above the rail, redrawn as SVG so it takes the theme accent. */
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <path d="M21 2c10 4 16.5 13.5 18.5 27.5H23.4c1.6-7.6 1.4-15.6-2.4-24l3.4 1.4L21 2z" fill="currentColor" opacity=".55"/>
  <path d="M21 2c10 4 16.5 13.5 18.5 27.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
  <path d="M13 30.5h34c-2.2 1.6-4.4 1.6-6.6 0-2.2 1.6-4.4 1.6-6.6 0-2.2 1.6-4.4 1.6-6.6 0-2.2 1.6-4.4 1.6-6.6 0-2.2 1.6-4.4 1.6-7.6 0z" fill="currentColor"/>
  <rect x="13" y="31" width="34" height="4.6" fill="currentColor"/>
  <path d="M37 35.6c1.4 9-1 17.4-9.6 24" fill="none" stroke="currentColor" stroke-width="4.2" stroke-linecap="round"/>
  <path d="M40.6 40l3.4-.4M40.8 46.2l3.4.6M38.8 52l3 1.6M35 56.8l2.2 2.6M30.6 60.2l1 3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
