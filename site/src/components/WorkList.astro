---
import { work } from '../data/work';
interface Props { limit?: number }
const { limit } = Astro.props;
const items = limit ? work.slice(0, limit) : work;
---
<ol class="work" role="list">
  {items.map((w) => (
    <li class="work__item">
      <p class="work__sector">{w.sector}</p>
      {w.result ? (
        <p class="work__result">
          <span class="work__value">{w.result}</span>
          <span class="work__label">{w.resultLabel}</span>
        </p>
      ) : (
        <p class="work__result work__result--plain">
          <span class="work__label">{w.platforms}</span>
        </p>
      )}
      <h3>{w.title}</h3>
      <p class="work__detail">{w.detail}</p>
    </li>
  ))}
</ol>

<style>
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--s6);
    row-gap: var(--s7);
  }

  .work__item {
    padding-top: var(--s4);
    border-top: 2px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .work__item:hover {
    border-top-color: var(--accent);
  }

  .work__sector {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .work__result {
    display: grid;
    gap: 0.2rem;
    min-height: 5.2rem;
    align-content: end;
  }

  .work__value {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 700;
    font-style: italic;
    font-size: var(--step-4);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .work__label {
    color: var(--ink);
    font-weight: 500;
  }

  .work__result--plain .work__label {
    color: var(--muted);
    font-weight: 400;
  }

  .work__detail {
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .work {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .work {
      grid-template-columns: 1fr;
    }
    .work__result {
      min-height: 0;
    }
  }
</style>
